# ---------------------------------------------------------------
# Server environment — copy this file to server/.env and fill in.
#   cp .env.example server/.env
# ---------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/security-marketing
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/security-marketing?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/security-marketing

# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=5000

# Comma-separated list of origins allowed to POST the contact form.
# Dev default covers the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Lead notification emails, sent through Resend (https://resend.com).
# Leave RESEND_API_KEY empty to disable. LEAD_NOTIFY_TO takes a comma-separated
# list. Without a verified domain, LEAD_NOTIFY_FROM must stay on onboarding@resend.dev
# and LEAD_NOTIFY_TO can only be the email the Resend account was created with.
RESEND_API_KEY=
LEAD_NOTIFY_TO=info@securitymarketingcompany.com
LEAD_NOTIFY_FROM=Security Marketing Company <onboarding@resend.dev>
# Visitors also get a confirmation email once LEAD_NOTIFY_FROM is on a verified domain.
# Its Reply-To is the business email, BUSINESS_EMAIL in server/src/config.js
# (info@securitymarketingcompany.com) — not an environment variable.

# Blog admin (/admin) GitHub sign-in — a GitHub OAuth App (README, "Blog admin").
# Never commit the real secret; set both on Render.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the repo the admin edits (default Manav-p765/SecurityMarketingCompany)
# GITHUB_REPO=
# Optional: website origins allowed to receive the sign-in token
# (default: https://www.securitymarketingcompany.com, https://securitymarketingcompany.com
# and CORS_ORIGIN)
# CMS_ORIGINS=

# Set to "production" when deploying so Express serves client/dist.
NODE_ENV=development
