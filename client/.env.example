# ---------------------------------------------------------------
# Client build environment (optional).
# The site calls the API at relative /api URLs — Vercel rewrites them to
# the API on Render (vercel.json); locally Vite proxies them to Express.
# ---------------------------------------------------------------

# API the build fetches published blog posts from.
# Default: https://securitymarketingcompany.onrender.com
# For a local build against your local API: BLOG_API_URL=http://localhost:5000
BLOG_API_URL=

# Local dev/preview servers forward /api here. Default: http://localhost:5000
LOCAL_API_URL=
